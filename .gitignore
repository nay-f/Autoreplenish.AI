# Environment files and secrets
.env
.env.*
!.env.example
dashboard/.env
dashboard/.env.*
!dashboard/.env.example

# Existing secret/config files
.env.secret
.env.production

# Python
__pycache__/
*.py[cod]
venv/

# Frontend
dashboard/node_modules/
dashboard/dist/

# Kaggle datasets and generated backtesting output
datasets/raw/*
!datasets/raw/.gitkeep
datasets/processed/*
!datasets/processed/.gitkeep
datasets/reports/*
!datasets/reports/.gitkeep

# Cache, Testing & Logs
.pytest_cache/
.coverage
htmlcov/
*.log
*.sqlite
*.sqlite3
*.db
.DS_Store
Thumbs.db

# Terraform state, providers, plans, and local variable files
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfplan
infra/terraform/*.plan
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example

# Lambda build artifacts
build/

# Local secret payloads used only for Secrets Manager uploads
*-secrets.json
secrets*.json

# Local CLI tools & binaries
cf-cli/

# Local docs, reviews, and scratch files (kept on local workstation)
docs/
scripts/scratch/

# SAP BTP Cloud Foundry manifest with live secrets
sap-btp-service/manifest.yml
!sap-btp-service/manifest.yml.example
