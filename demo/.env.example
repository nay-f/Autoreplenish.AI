# ============================================
# AUTOREPLENISH.AI — LOCAL DEMO CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# Telegram Bot (REQUIRED — get from @BotFather)
TELEGRAM_BOT_TOKEN=MASUKKAN_TOKEN_BOT_ANDA
TELEGRAM_CHAT_ID=MASUKKAN_CHAT_ID_ANDA

# Demo Mode Settings (do not change)
DEMO_MODE=local
ENVIRONMENT=demo
AWS_MODE=mock
BEDROCK_MODE=mock
SAP_MODE=mock
WEATHER_MODE=mock
CALENDAR_MODE=mock
DB_MODE=sqlite
TELEGRAM_MODE=polling

# AI Configuration
PROMPT_VERSION=v1.0
MODEL_NAME=anthropic.claude-3-5-sonnet

# Database
SQLITE_DB_PATH=db/demo.db

# Dashboard API
DASHBOARD_API_PORT=8000
