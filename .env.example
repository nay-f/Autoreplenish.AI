# Copy this file to .env.development or .env.staging, then replace every CHANGE_ME value.
# Never commit real credentials or production secrets.

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
DYNAMODB_TABLE=AutoReplenish_DevTable
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-5-5-20251001-v1:0

OPENWEATHER_API_KEY=CHANGE_ME
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_DEFAULT_CHAT_ID=CHANGE_ME

SAP_TOKEN_URL=https://sandbox.example/oauth/token
SAP_CLIENT_ID=CHANGE_ME
SAP_CLIENT_SECRET=CHANGE_ME
SAP_AI_API_URL=https://sandbox.example/odata

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
JWT_EXPIRE_HOURS=8
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ENVIRONMENT=development
SAP_WRITE_ENABLED=false
