# ==============================================================================
# AUTOREPLENISH.AI — PRODUCTION & LOCAL RUNNER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Salin file ini ke .env dan isi nilai kredensial nyata sesuai kebutuhan.

# ------------------------------------------------------------------------------
# 1. TELEGRAM BOT API (Human-in-the-Loop Notifications & Inline Buttons)
# ------------------------------------------------------------------------------
# Dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 2. OPENWEATHERMAP API (Real-Time Hyperlocal Weather by Latitude & Longitude)
# ------------------------------------------------------------------------------
# Dapatkan API Key gratis di https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=

# ------------------------------------------------------------------------------
# 3. AWS BEDROCK (Claude 3.5 Sonnet Agentic Reasoning)
# ------------------------------------------------------------------------------
# Kosongkan jika ingin menggunakan deterministic rule-based fallback
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
PROMPT_VERSION=v1.0

# ------------------------------------------------------------------------------
# 4. SAP S/4HANA & SAP BTP INTEGRATION (OData API_PURCHASEREQ_PROCESS_SRV)
# ------------------------------------------------------------------------------
# Kosongkan jika ingin menggunakan mode strict persistent sandbox (format envelope OData valid {"d": {...}})
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_TOKEN_URL=
SAP_ODATA_URL=https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/API_PURCHASEREQ_PROCESS_SRV

# ------------------------------------------------------------------------------
# 5. LOCAL RUNNER & DATABASE SETTINGS
# ------------------------------------------------------------------------------
DEMO_MODE=local
ENVIRONMENT=production_local
DB_MODE=sqlite
SQLITE_DB_PATH=demo/db/demo.db
DASHBOARD_API_PORT=8000
DASHBOARD_API_URL=http://localhost:8000
